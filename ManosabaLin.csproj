<Project Sdk="Godot.NET.Sdk/4.5.1">
    <Import Project=".\local.props" Condition="Exists('.\local.props')"/>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>true</ImplicitUsings>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <AppOutputBase>$(MSBuildProjectDirectory)/</AppOutputBase>
        <PathMap>$(AppOutputBase)=./</PathMap>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <NoWarn>$(NoWarn);MSB3270;CS0436</NoWarn>
        <RootNamespace>ManosabaLin</RootNamespace>
        <Version>0.3.6</Version>
    </PropertyGroup>

    <PropertyGroup>
        <GodotExportPreset>Windows Desktop</GodotExportPreset>

        <ModOutputDir>$(Sts2Path)/mods/$(MSBuildProjectName)/</ModOutputDir>
        <ModPckPath>$(ModOutputDir)$(MSBuildProjectName).pck</ModPckPath>

        <ModsPath>$(Sts2Path)/mods</ModsPath> <!-- 自动拷贝 MinionLib 到 mods 目录 -->
        <RitsuLibDeployDir>$(Sts2Path)/mods/RitsuLib</RitsuLibDeployDir> <!-- 自动拷贝 RitsuLib 到 mods 目录 -->
    </PropertyGroup>

    <!-- FMod 自动化相关配置 -->
    <PropertyGroup>
        <FmodStudioPath Condition="'$(FmodStudioPath)' == ''">D:\FMOD Studio 2.03.13\fmodstudiocl.exe</FmodStudioPath>
        <FmodProjectFile>$(MSBuildProjectDirectory)/FMod/$(MSBuildProjectName).fspro</FmodProjectFile>
        <FmodBuildDir>$(MSBuildProjectDirectory)/FMod/Build</FmodBuildDir>
        <AudioDestDir>$(MSBuildProjectDirectory)/$(MSBuildProjectName)/audio</AudioDestDir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <!--        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="*" />-->
        <PackageReference Include="STS2.RitsuLib" Version="0.4.54" PrivateAssets="All" GeneratePathProperty="true" />
        <PackageReference Include="FuYnAloft.Sts2.MinionLib" Version="0.6.0" PrivateAssets="All" GeneratePathProperty="true" />
    </ItemGroup>

    <ItemGroup>
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="0Harmony" HintPath="$(Sts2DataDir)\0Harmony.dll" Private="True"/>
        <Reference Include="sts2" HintPath="$(Sts2DataDir)\sts2.dll" Private="True"/>
        <Reference Include="Steamworks.NET" HintPath="$(Sts2DataDir)\Steamworks.NET.dll" Private="True"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="ManosabaLin/localization/**/*.json"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="ManosabaLin/**"/>
        <Compile Remove="materials/**"/>
        <Compile Remove="shaders/**"/>
        <Compile Remove="images/**"/>
        <EmbeddedResource Remove="ManosabaLin/**"/>
        <EmbeddedResource Remove="materials/**"/>
        <EmbeddedResource Remove="shaders/**"/>
        <EmbeddedResource Remove="images/**"/>
        <Compile Remove="ManosabaLin\audio\**"/>
        <Compile Remove="替身\**"/>
        <EmbeddedResource Remove="ManosabaLin\audio\**"/>
        <Compile Remove=".godot\**" />
        <EmbeddedResource Remove=".godot\**" />
    </ItemGroup>

    <ItemGroup>
        <None Condition="Exists('Directory.Build.props')" Include="Directory.Build.props"/>
        <None Include=".gitignore"/>
        <None Include="ManosabaLin.template.json" />
        <None Include="project.godot"/>
        <None Include="ManosabaLin/**"/>
        <!--        <None Remove="ManosabaLin\audio\**"/>-->
        <None Include="FMOD/Scripts/**"/>
        <None Include=".codex/**"/>
        <None Include="AGENTS.md"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="ManosabaLinCode\Characters\Anan\"/>
        <Folder Include="ManosabaLinCode\Characters\Hanna\"/>
        <Folder Include="ManosabaLinCode\Characters\Hiro\Ancients\"/>
        <Folder Include="ManosabaLinCode\Characters\Hiro\Potions\"/>
        <Folder Include="ManosabaLinCode\Characters\Koko\"/>
        <Folder Include="ManosabaLinCode\Characters\Leia\"/>
        <Folder Include="ManosabaLin\images\map\placeholder\" />
        <Folder Include="ManosabaLin\images\powers\big\"/>
        <Folder Include="ManosabaLin\images\relics\big\"/>
        <Folder Include="ManosabaLin\images\ui\run_history\" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="local.props" />
    </ItemGroup>

    <Target Name="ValidateSts2GameInstall" BeforeTargets="ResolveAssemblyReferences">
        <Error
                Condition="!Exists('$(Sts2DataDir)\sts2.dll')"
                Text="Could not find sts2.dll under '$(Sts2DataDir)'. Set Sts2Path in local.props following the WineFox pattern."/>
    </Target>

    <!-- 自动更新 json 中的版本号 -->
    <Target Name="UpdateManifestVersion" BeforeTargets="BeforeBuild">
        <PropertyGroup>
            <RitsuVersion>$([System.IO.Path]::GetFileName($(PkgSTS2_RitsuLib)))</RitsuVersion>
            <MinionLibVersion>$([System.IO.Path]::GetFileName($(PkgFuYnAloft_Sts2_MinionLib)))</MinionLibVersion>

            <ManifestTemplateFile>$(MSBuildProjectDirectory)/$(MSBuildProjectName).template.json</ManifestTemplateFile>

            <ManifestOutputFile>$(IntermediateOutputPath)$(MSBuildProjectName).json</ManifestOutputFile>
        </PropertyGroup>

        <Message Text="Updating version in $(ManifestOutputFile) to $(Version)" Importance="high"/>

        <ItemGroup>
            <FileLines Include="$([System.IO.File]::ReadAllText($(ManifestTemplateFile))
                .Replace('__THIS_VERSION__', '$(Version)')
                .Replace('__GAME_VERSION__', '$(Sts2Version)')
                .Replace('__STS2-RitsuLib_VERSION__', '$(RitsuVersion)')
                .Replace('__MinionLib_VERSION__', '$(MinionLibVersion)'))"/>
        </ItemGroup>

        <WriteLinesToFile File="$(ManifestOutputFile)" Lines="@(FileLines)" Overwrite="true" WriteOnlyWhenDifferent="true"/>
    </Target>

    <Target Name="CopyMod" AfterTargets="PostBuildEvent">
        <Message Text="Copying mod to Slay the Spire 2 mods folder..." Importance="high"/>
        <MakeDir Directories="$(ModOutputDir)"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDir)"/>
        <Copy SourceFiles="$(ManifestOutputFile)" DestinationFolder="$(ModOutputDir)"/>
    </Target>

    <Target Name="BuildAndCopyFmod" BeforeTargets="ExportPCK">
        <Message Text="[FMOD] Starting Headless Build..." Importance="high"/>

        <Exec Command="&quot;$(FmodStudioPath)&quot; -build -export-guids &quot;$(FmodProjectFile)&quot;" />

        <ItemGroup>
            <FmodAssetsToCopy Include="$(FmodBuildDir)/GUIDs.txt" />
            <FmodAssetsToCopy Include="$(FmodBuildDir)/desktop/ManosabaLin.bank" />
        </ItemGroup>

        <Message Text="[FMOD] Copying files to $(AudioDestDir)..." Importance="high"/>
        <Copy
                SourceFiles="@(FmodAssetsToCopy)"
                DestinationFolder="$(AudioDestDir)"
                SkipUnchangedFiles="true" />
    </Target>

    <Target Name="ExportPCK" AfterTargets="Publish" Condition="'$(STS2_SKIP_PCK_EXPORT)' != '1' and Exists('$(GodotPath)')">
        <Message Text="Exporting mod PCK with MegaDot..." Importance="high"/>
        <Message Text="Sts2Path=$(Sts2Path), Sts2DataDir=$(Sts2DataDir), ModOutputDir=$(ModOutputDir), ModPckPath=$(ModPckPath)" Importance="high"/>
        <MakeDir Directories="$(ModOutputDir)"/>
        <Exec Command="&quot;$(GodotPath)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --export-pack &quot;$(GodotExportPreset)&quot; &quot;$(ModPckPath)&quot;" EnvironmentVariables="STS2_SKIP_PCK_EXPORT=1"/>
    </Target>

</Project>
